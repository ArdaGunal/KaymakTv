# ÖRNEK — bu dosyayı `keystore.properties` olarak kopyalayıp doldur.
# Gerçek dosya .gitignore'da; git'e ASLA girmez.
#
# Değerler `npx eas-cli credentials -p android` → Keystore → Download
# çıktısında gösterilir (Keystore password / Key alias / Key password).

storePassword=BURAYA_KEYSTORE_PAROLASI
keyAlias=BURAYA_KEY_ALIAS
keyPassword=BURAYA_KEY_PAROLASI
